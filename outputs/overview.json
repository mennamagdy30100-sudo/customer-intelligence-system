  {
   "title": "مفيش فرق واضح في المبيعات بين الإجازات وأيام الشغل",
   "strength": "واضح",
   "detail": "في الإجازات (الجمعة والسبت والأعياد الرسمية) بنبيع 63 طلب في اليوم، وفي أيام الشغل 66 طلب في اليوم.",
   "action": "الإجازات مش موسم مبيعات في الداتا دي، فمفيش داعي لحملة عروض عامة مربوطة بيها."
  },
  {
   "title": "عملاء كتير وقفوا يشتروا",
   "strength": "واضح",
   "detail": "العملاء اللي طلبوا في أول 3 شهور: 1,772، وفي آخر 3 شهور: 1,246. و753 عميل غايب أكتر من معتاده.",
   "action": "ده أهم فرصة: ابعت عرض استرجاع للعملاء الغايبين (فلتر 'غايب عن معتاده' في القايمة)."
  },
  {
   "title": "الخصم مابيزوّدش حجم الطلب",
   "strength": "مؤشر",
   "detail": "الطلب بخصم فيه 8.2 قطعة بمتوسط قيمة 213، والطلب من غير خصم فيه 8.3 قطعة بمتوسط قيمة 240. يعني الخصم قلّل قيمة الطلب ومازوّدش عدد القطع.",
   "action": "بلاش خصومات عامة، وخلّي الخصم للعميل الغايب أو بحد أدنى للفاتورة. وجرّبوا ده على مجموعة صغيرة الأول."
  },
  {
   "title": "أنماط الإجازات والخصومات والفئات المفضلة لكل عميل قريبة من الصدفة",
   "strength": "واضح",
   "detail": "من 1,148 عميل طلباتهم كفاية للحكم: طلع 50 عميل بنمط في الإجازات، و60 بنمط في الخصومات، و45 بفئة مفضلة. ولو مفيش أي نمط حقيقي، المتوقع صدفة حوالي 52 عميل في كل واحدة من التلاتة.",
   "action": "الأنماط الفردية دي بتتاخد كإشارة مش كحقيقة. استخدمي الإجراءات اللي اتأكدت من الداتا (العملاء الغايبين وشكل الطلب)، وكل ما تضيفي شهور أكتر من الطلبات هتبان الأنماط الفردية أوضح."
  }
